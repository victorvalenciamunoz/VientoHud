<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-first (docs/PLAN.md phase 7), as CieloHud. Overrides the net10.0 of Directory.Build.props. -->
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>VientoHud.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>VientoHud</ApplicationTitle>
		<ApplicationId>com.vientohud.app</ApplicationId>
		<!-- ApplicationVersion is major*10000 + minor*100 + patch: Android installs an update only if it grows. -->
		<ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
		<ApplicationVersion>300</ApplicationVersion>

		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Fast Deployment can leave stale resource ids on the phone (crash "No view found for id" at startup); embed assemblies instead. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- The Thunderforest key travels inside the app, read at build time from the user's environment (DECISIONS 050). Never in the repo. -->
	<ItemGroup Condition="'$(VIENTOHUD_THUNDERFOREST_KEY)' != ''">
		<AssemblyMetadata Include="ThunderforestKey" Value="$(VIENTOHUD_THUNDERFOREST_KEY)" />
	</ItemGroup>
	<!-- Development only: a BRouter other than brouter.de (the local one, DECISIONS 018: http://10.0.2.2:17777/ from the emulator). -->
	<ItemGroup Condition="'$(VIENTOHUD_APP_BROUTER_URL)' != ''">
		<AssemblyMetadata Include="BRouterUrl" Value="$(VIENTOHUD_APP_BROUTER_URL)" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1218" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1218" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
		<!-- License texts that must travel with the app (OFL fonts, third-party notices). Taken from the repo root, not copied. -->
		<MauiAsset Include="..\..\THIRD-PARTY-NOTICES.md;..\..\licenses\*.txt" LogicalName="licenses\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Mapsui.Maui" Version="5.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VientoHud.Core\VientoHud.Core.csproj" />
	</ItemGroup>

</Project>
